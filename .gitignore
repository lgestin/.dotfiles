*.env
.env
.env.*
secrets*
*.secret
*.secrets
.secrets/

# per-machine private overrides (secrets, keys)
*.local

# zed local settings: machine-specific ssh connections, kept untracked
zed_local/.config/zed/settings.json
zed_local/.config/zed/settings_backup.json

# fish universal variables: machine-specific absolute paths,
# regenerated by fish_add_path in config.fish on each machine
fish/.config/fish/fish_variables
